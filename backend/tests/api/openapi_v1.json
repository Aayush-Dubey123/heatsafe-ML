{
 "components": {
  "schemas": {
   "AssetCategory": {
    "description": "Cooling-related place categories (OpenStreetMap).",
    "enum": [
     "green_space",
     "water_body",
     "health_facility",
     "public_shelter",
     "drinking_water"
    ],
    "title": "AssetCategory",
    "type": "string"
   },
   "CoolingSpot": {
    "description": "A public cooling-related place from OpenStreetMap.",
    "properties": {
     "asset_id": {
      "title": "Asset Id",
      "type": "string"
     },
     "category": {
      "title": "Category",
      "type": "string"
     },
     "distance_km": {
      "title": "Distance Km",
      "type": "number"
     },
     "latitude": {
      "title": "Latitude",
      "type": "number"
     },
     "longitude": {
      "title": "Longitude",
      "type": "number"
     },
     "name": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Name"
     }
    },
    "required": [
     "asset_id",
     "category",
     "name",
     "latitude",
     "longitude",
     "distance_km"
    ],
    "title": "CoolingSpot",
    "type": "object"
   },
   "CoolingSpotsResponse": {
    "description": "Cooling places near a point, nearest first.",
    "properties": {
     "count": {
      "title": "Count",
      "type": "integer"
     },
     "latitude": {
      "title": "Latitude",
      "type": "number"
     },
     "longitude": {
      "title": "Longitude",
      "type": "number"
     },
     "radius_km": {
      "title": "Radius Km",
      "type": "number"
     },
     "source": {
      "default": "OpenStreetMap contributors (ODbL); completeness varies",
      "title": "Source",
      "type": "string"
     },
     "spots": {
      "items": {
       "$ref": "#/components/schemas/CoolingSpot"
      },
      "title": "Spots",
      "type": "array"
     }
    },
    "required": [
     "latitude",
     "longitude",
     "radius_km",
     "count",
     "spots"
    ],
    "title": "CoolingSpotsResponse",
    "type": "object"
   },
   "ErrorBody": {
    "description": "Machine- and human-readable description of a failed request.\n\nAttributes:\n    code (str): Stable snake_case error code clients can branch on.\n    message (str): Safe, human-readable summary (never a stack trace).\n    details (list[dict[str, Any]] | None): Optional field-level problems.\n    request_id (str): Correlation ID echoed in the X-Request-ID header.",
    "properties": {
     "code": {
      "description": "Stable snake_case error code, e.g. 'validation_error'.",
      "title": "Code",
      "type": "string"
     },
     "details": {
      "anyOf": [
       {
        "items": {
         "additionalProperties": true,
         "type": "object"
        },
        "type": "array"
       },
       {
        "type": "null"
       }
      ],
      "description": "Optional field-level problems (location, message, type).",
      "title": "Details"
     },
     "message": {
      "description": "Safe human-readable summary of the error.",
      "title": "Message",
      "type": "string"
     },
     "request_id": {
      "description": "Correlation ID matching the X-Request-ID response header.",
      "title": "Request Id",
      "type": "string"
     }
    },
    "required": [
     "code",
     "message",
     "request_id"
    ],
    "title": "ErrorBody",
    "type": "object"
   },
   "ErrorResponse": {
    "description": "Uniform error envelope returned by every endpoint (Decision T15).\n\nAttributes:\n    error (ErrorBody): The error description.",
    "properties": {
     "error": {
      "$ref": "#/components/schemas/ErrorBody"
     }
    },
    "required": [
     "error"
    ],
    "title": "ErrorResponse",
    "type": "object"
   },
   "GeoJSONFeatureCollection": {
    "description": "Generic GeoJSON FeatureCollection (WGS84).",
    "properties": {
     "features": {
      "items": {
       "additionalProperties": true,
       "type": "object"
      },
      "title": "Features",
      "type": "array"
     },
     "properties": {
      "anyOf": [
       {
        "additionalProperties": true,
        "type": "object"
       },
       {
        "type": "null"
       }
      ],
      "title": "Properties"
     },
     "type": {
      "default": "FeatureCollection",
      "title": "Type",
      "type": "string"
     }
    },
    "required": [
     "features"
    ],
    "title": "GeoJSONFeatureCollection",
    "type": "object"
   },
   "HealthPingRequest": {
    "description": "Inbound request schema for optional diagnostic ping payload.\n\nAttributes:\n    client_tag (Optional[str]): Diagnostic identifier passed by caller.\n    echo_message (Optional[str]): Echo test string for transport validation.",
    "properties": {
     "client_tag": {
      "anyOf": [
       {
        "maxLength": 64,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "Diagnostic identifier of the calling service or test runner.",
      "title": "Client Tag"
     },
     "echo_message": {
      "anyOf": [
       {
        "maxLength": 128,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "Optional echo test string verified on return.",
      "title": "Echo Message"
     }
    },
    "title": "HealthPingRequest",
    "type": "object"
   },
   "HealthResponse": {
    "description": "Standardized operational health and status check payload schema.\n\nAttributes:\n    status (str): Operational state indicator ('healthy', 'degraded', 'down').\n    service (str): Service name identifier.\n    version (str): Application semantic release version.\n    timestamp (datetime): UTC timestamp of generated health response.\n    database (str): Database connectivity state.\n    echo (Optional[str]): Echoed client diagnostic message if provided.",
    "properties": {
     "database": {
      "default": "connected",
      "description": "Persistence engine status.",
      "title": "Database",
      "type": "string"
     },
     "echo": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "Optional diagnostic echo string.",
      "title": "Echo"
     },
     "service": {
      "default": "heatsafe-backend",
      "description": "Service identifier.",
      "title": "Service",
      "type": "string"
     },
     "status": {
      "description": "Operational health indicator of the service.",
      "title": "Status",
      "type": "string"
     },
     "timestamp": {
      "description": "UTC timestamp of generated status.",
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
     },
     "version": {
      "default": "0.1.0",
      "description": "Application semantic version.",
      "title": "Version",
      "type": "string"
     }
    },
    "required": [
     "status",
     "timestamp"
    ],
    "title": "HealthResponse",
    "type": "object"
   },
   "HeatResponse": {
    "description": "Heat answer for one location.\n\nAttributes:\n    lst_celsius (float | None): Model 1 land-surface temperature estimate (not air temperature).\n    lst_p05 (float | None): 5th percentile bound of the 90% range.\n    lst_p95 (float | None): 95th percentile bound of the 90% range.\n    observed (bool): True if the satellite saw this cell clearly in the latest scene; False if model-filled.\n    covered (bool): False for open water or cells without an estimate.",
    "properties": {
     "covered": {
      "title": "Covered",
      "type": "boolean"
     },
     "latitude": {
      "title": "Latitude",
      "type": "number"
     },
     "locality": {
      "anyOf": [
       {
        "$ref": "#/components/schemas/Locator"
       },
       {
        "type": "null"
       }
      ]
     },
     "longitude": {
      "title": "Longitude",
      "type": "number"
     },
     "lst_celsius": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "title": "Lst Celsius"
     },
     "lst_p05": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "title": "Lst P05"
     },
     "lst_p95": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "title": "Lst P95"
     },
     "note": {
      "title": "Note",
      "type": "string"
     },
     "observed": {
      "title": "Observed",
      "type": "boolean"
     },
     "product": {
      "$ref": "#/components/schemas/ProductInfo"
     },
     "seasons": {
      "additionalProperties": {
       "$ref": "#/components/schemas/SeasonExposure"
      },
      "title": "Seasons",
      "type": "object"
     },
     "zone": {
      "anyOf": [
       {
        "$ref": "#/components/schemas/Locator"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "required": [
     "latitude",
     "longitude",
     "covered",
     "lst_celsius",
     "lst_p05",
     "lst_p95",
     "observed",
     "locality",
     "zone",
     "seasons",
     "product",
     "note"
    ],
    "title": "HeatResponse",
    "type": "object"
   },
   "LayerInfo": {
    "description": "One map layer the frontend can display.\n\nAttributes:\n    id (str): Layer id used in tile URLs.\n    kind (str): \"lst\" (surface temperature, deg C) or \"exposure\" (index 0-100).\n    season (str | None): Season for seasonal layers; None for the latest scene.\n    tile_url (str): Tile URL template with {z}/{x}/{y}.\n    vmin (float): Value mapped to the low end of the colour scale.\n    vmax (float): Value mapped to the high end.\n    unit (str): Unit label.",
    "properties": {
     "id": {
      "title": "Id",
      "type": "string"
     },
     "kind": {
      "title": "Kind",
      "type": "string"
     },
     "season": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Season"
     },
     "tile_url": {
      "title": "Tile Url",
      "type": "string"
     },
     "unit": {
      "title": "Unit",
      "type": "string"
     },
     "vmax": {
      "title": "Vmax",
      "type": "number"
     },
     "vmin": {
      "title": "Vmin",
      "type": "number"
     }
    },
    "required": [
     "id",
     "kind",
     "season",
     "tile_url",
     "vmin",
     "vmax",
     "unit"
    ],
    "title": "LayerInfo",
    "type": "object"
   },
