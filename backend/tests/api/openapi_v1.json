   "MetricLayer": {
    "description": "Layers that locality metrics are reported for.",
    "enum": [
     "latest_scene",
     "summer",
     "monsoon",
     "post-monsoon",
     "winter"
    ],
    "title": "MetricLayer",
    "type": "string"
   },
   "ProductInfo": {
    "description": "Which published product an answer comes from and how fresh it is (Decision D2).\n\nAttributes:\n    version (str): Bundle version.\n    scene_id (str): Landsat scene id.\n    scene_date (str): Acquisition date, YYYY-MM-DD.\n    scene_age_days (int): Days since acquisition, computed at request time.\n    stale (bool): True when the scene is older than the freshness limit (16 days).\n    model_version (str): Model 1 version that produced the estimate.\n    published_utc (str | None): When the bundle was published.\n    observed_fraction (float | None): Share of land cells with a clear observation (rest is model-filled).",
    "properties": {
     "model_version": {
      "title": "Model Version",
      "type": "string"
     },
     "observed_fraction": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "title": "Observed Fraction"
     },
     "published_utc": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Published Utc"
     },
     "scene_age_days": {
      "title": "Scene Age Days",
      "type": "integer"
     },
     "scene_date": {
      "title": "Scene Date",
      "type": "string"
     },
     "scene_id": {
      "title": "Scene Id",
      "type": "string"
     },
     "stale": {
      "title": "Stale",
      "type": "boolean"
     },
     "version": {
      "title": "Version",
      "type": "string"
     }
    },
    "required": [
     "version",
     "scene_id",
     "scene_date",
     "scene_age_days",
     "stale",
     "model_version"
    ],
    "title": "ProductInfo",
    "type": "object"
   },
