 "info": {
  "description": "Geospatial Machine Learning & Heat Exposure Analytics API for Nagpur, India",
  "title": "HeatSafe-ML Backend API",
  "version": "contract"
 },
 "openapi": "3.1.0",
 "paths": {
  "/api/v1/cooling-spots": {
   "get": {
    "description": "Parks, water bodies, health facilities, shelters and drinking water near a point, nearest first (OpenStreetMap; completeness varies).",
    "operationId": "cooling_spots_api_v1_cooling_spots_get",
    "parameters": [
     {
      "in": "query",
      "name": "lat",
      "required": true,
      "schema": {
       "examples": [
        21.1458
       ],
       "maximum": 21.3,
       "minimum": 21.0,
       "title": "Lat",
       "type": "number"
      }
     },
     {
      "in": "query",
      "name": "lon",
      "required": true,
      "schema": {
       "examples": [
        79.0882
       ],
       "maximum": 79.3,
       "minimum": 78.9,
       "title": "Lon",
       "type": "number"
      }
     },
     {
      "in": "query",
      "name": "category",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "$ref": "#/components/schemas/AssetCategory"
        },
        {
         "type": "null"
        }
       ],
       "title": "Category"
      }
     },
     {
      "in": "query",
      "name": "limit",
      "required": false,
      "schema": {
       "default": 10,
       "maximum": 50,
       "minimum": 1,
       "title": "Limit",
       "type": "integer"
      }
     },
     {
      "in": "query",
      "name": "radius_km",
      "required": false,
      "schema": {
       "default": 5.0,
       "exclusiveMinimum": 0,
       "maximum": 20,
       "title": "Radius Km",
       "type": "number"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/CoolingSpotsResponse"
        }
       }
      },
      "description": "Successful Response"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ErrorResponse"
        }
       }
      },
      "description": "Invalid or out-of-area coordinates"
     },
     "500": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ErrorResponse"
        }
       }
      },
      "description": "Internal server error"
     },
     "503": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ErrorResponse"
        }
       }
      },
      "description": "No heat product is published yet"
     }
    },
    "summary": "Nearest cooling places",
    "tags": [
     "areas"
    ]
   }
  },
