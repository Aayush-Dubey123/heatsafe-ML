flowchart TD
  %% =========================================================================
  %% HeatSafe-ML Urban Heat Intelligence Pipeline (Balanced Landscape Tree)
  %% Clean horizontal tiers, 4-card balanced grid, and verified repository evidence.
  %% =========================================================================

  ROOT["<b>HeatSafe-ML: Geospatial ML for Urban Heat Intelligence in Nagpur</b><br/>Goal: Convert multi-source geospatial data into heat insights (LST, heat zones, drivers) using a reproducible, verified pipeline.<br/><i>[Branch 1: Backend and ML Engine (Active) | Branch 2: Frontend Dashboard (Locked)]</i>"]

  ROOT --> S_SOURCES

  %% -------------------------------------------------------------------------
  %% Tier 1: Environmental Data Sources (External / Free Inputs)
  %% -------------------------------------------------------------------------
  subgraph S_SOURCES ["Data Sources (External / Free Inputs)"]
    direction LR
    SRC_LANDSAT["<b>Landsat 8 and 9</b><br/>(USGS C2 L2)<br/>- Thermal (ST_B10) and Optical (B3-B6)<br/>- 125 L8/9 scenes (2019-2025) verified (D7)<br/>- 30 m resampled analytical grid<br/>- Status: INGESTED and VERIFIED"]
    SRC_S2["<b>Sentinel-2</b><br/>(Copernicus L2A)<br/>- Multispectral optical (B3, B4, B8, B11)<br/>- 10/20 m resampled to 30 m grid<br/>- High-res vegetation and water features<br/>- Status: FEASIBILITY VERIFIED"]
    SRC_DEM["<b>Copernicus DEM</b><br/>(GLO-30 Global DSM)<br/>- 30 m static elevation (N21E078/079)<br/>- Used for Horn slope and aspect derivatives<br/>- Topographic elevation plain ~300 m<br/>- Status: INGESTED and VERIFIED"]
    SRC_BOUND["<b>Boundary Data</b><br/>(OSM / NMC Official)<br/>- Authoritative NMC municipal boundary<br/>- 10 administrative zone boundaries<br/>- Topologically verified GeoJSONs<br/>- Status: INGESTED and REGISTERED"]
    SRC_MET["<b>IMD and CPCB</b><br/>(Ground Stations)<br/>- 2 m ambient air temp, humidity, wind<br/>- Sonegaon Airport and CAAQMS sites<br/>- Distinct kinetic air temp for validation<br/>- Status: AUDITED INVENTORY"]

    SRC_LANDSAT ~~~ SRC_S2 ~~~ SRC_DEM ~~~ SRC_BOUND ~~~ SRC_MET
  end

  S_SOURCES --> S_PIPE

  %% -------------------------------------------------------------------------
  %% Tier 2: Phased Data Processing and Feature Pipeline (Core ML Stack)
  %% -------------------------------------------------------------------------
  subgraph S_PIPE ["Data Processing and Feature Pipeline (Core ML Stack)"]
    direction LR
    P1["<b>Phase 1</b><br/>Study Area and Feasibility<br/>- Verify Nagpur (NMC) boundary<br/>- Master 30 m grid (748,890 cells)<br/>- Station inventory and D1-D4, D6 locked<br/>- Assess data availability and licenses<br/>[PASS] Completed and Verified"]
    P2["<b>Phase 2</b><br/>Data Ingestion and Management<br/>- Download and organize Landsat and DEM<br/>- Validate scenes (quality, date, coverage)<br/>- Exponential backoff retry resilience<br/>- Register assets in data_manifest.json<br/>[PASS] Completed and Verified (125 L8/9 scenes)"]
    P3["<b>Phase 3</b><br/>Preprocessing and Feature Engg.<br/>- Reproject to 30 m grid (EPSG:32644)<br/>- QA masking (cloud, shadow, snow, water)<br/>- Scale LST (deg C) and surface reflectance<br/>- Derive NDVI, NDBI, MNDWI indices<br/>- Compute slope and aspect (Horn 3x3)<br/>- Temporal and 2 km spatial blocks (D5)<br/>- Export features_v1.parquet (39.4 MB)<br/>[PASS] Completed and Verified (Sample Scene)"]
    P5["<b>Phase 5</b><br/>First Working Result and Baselines<br/>- Seasonal mean LST GeoTIFF and PNG maps<br/>- Getis-Ord Gi* hotspot clusters (p under 0.05)<br/>- Spearman LST vs NDVI, NDBI, MNDWI, elevation<br/>- Baselines 1-3 on validation folds only<br/>- 125 L8/9 scenes, 2.44 M sampled pixels<br/>- B3 CV RMSE 2.351 C (bar: 1.998 C)<br/>[IMPLEMENTED & TESTED] Closed 2026-11-09"]
    P6["<b>Phase 6</b><br/>Model 1 Development<br/>- LightGBM first, Random Forest comparison (CPU)<br/>- 2 km spatial-block CV and leakage test (D5)<br/>- 90% intervals via quantile models<br/>- SHAP drivers and JSON run logs<br/>- CV RMSE 1.227 C (-47.8% vs B3), 87.4% coverage<br/>[IMPLEMENTED & TESTED] Closed 2026-11-09"]
    P7["<b>Phase 7</b><br/>Validation and Model Card<br/>- 2026 test set opened once (D4)<br/>- Station comparison as a separate variable<br/>- Bootstrap 95% confidence intervals<br/>- Model Card and owner Go (D15)<br/>- 2026 test RMSE 1.36 C vs B3 2.43 C<br/>- Station comparison not done (no data access)<br/>[IMPLEMENTED & TESTED] Closed 2026-11-10"]
    P8["<b>Phase 8</b><br/>Exposure, Vulnerability and Cooling<br/>- Heat Exposure Index 0-100 from validated LST<br/>- 10 NMC zone vulnerability and ranks (T18)<br/>- OSM parks, water, hospitals, shelters<br/>- Aggregated only, no personal data<br/>- 889 OSM assets, rank intervals (1000 bootstraps)<br/>- Zone polygons approximate; 60+ share uniform<br/>[IMPLEMENTED & TESTED] Closed 2026-11-10"]

    P1 --> P2
    P2 --> P3
    P3 -- "features_v1.parquet" --> P5
    P5 -- "Baseline scores to beat" --> P6
    P6 -- "Trained model and intervals" --> P7
    P7 -- "Go decision and validated LST" --> P8
  end

  S_PIPE --> S_STRUCT

  %% -------------------------------------------------------------------------
  %% Tier 3: Core Architecture, Storage, Outputs and Verification
  %% -------------------------------------------------------------------------
  subgraph S_STRUCT ["Core Architecture, Storage, System Outputs and Verification"]
    direction LR
    BOX_REPO["<b>Core Repository Structure</b><br/>- <b>backend/</b> - FastAPI 4-layer health stack<br/>- <b>ml/</b> - Data pipeline, features, models<br/>- <b>data/</b> - Raw, processed and manifest<br/>- <b>configs/</b> - Study area, processing settings<br/>- <b>tests/</b> - Unit and integration test suites<br/>- Status: IMPLEMENTED and TESTED"]

    BOX_STORAGE[("<b>Data and Artifact Storage</b><br/>- <b>Raw Data:</b> ml/data/raw/ (125 cropped L8/9 scenes and DEM)<br/>- <b>Processed Data:</b> features_v1.parquet (39.4 MB)<br/>- <b>Data Manifest:</b> data_manifest.json (SHA-256)<br/>- <b>Maps:</b> data/processed/maps/ (planned GeoTIFFs)<br/>- Status: PERSISTED and REGISTERED")]

    BOX_OUTPUTS["<b>Pipeline System Outputs</b><br/>- <b>Clean feature dataset:</b> Parquet table<br/>- <b>Quality masks:</b> cloud, shadow, snow, water<br/>- <b>Derived indices:</b> NDVI, NDBI, MNDWI<br/>- <b>Terrain features:</b> elevation, slope, aspect<br/>- <b>Spatial and temporal:</b> 2 km blocks and solar time<br/>- Status: OPERATIONAL (Phase 3)"]

    BOX_VERIF["<b>Key Verification (Phase 3)</b><br/>[PASS] <b>Grid size:</b> 795 x 942 (30 m analytical grid)<br/>[PASS] <b>CRS:</b> EPSG:32644 (UTM Zone 44N)<br/>[PASS] <b>LST screening:</b> 0 deg C to 62 deg C valid range<br/>[PASS] <b>Missingness:</b> 0.16% (under 2% target)<br/>[PASS] <b>QA masks:</b> cloud, shadow, snow, water<br/>[PASS] <b>Tests:</b> 128/128 passed repository-wide<br/>[PASS] <b>Registered:</b> features_v1.parquet (SHA-256)"]

    BOX_REPO ~~~ BOX_STORAGE ~~~ BOX_OUTPUTS ~~~ BOX_VERIF
  end

  S_STRUCT -- "Validated LST, exposure layers and cooling assets (Phase 8 output)" --> S_SERVE

  %% -------------------------------------------------------------------------
  %% Tier 3b: Plan v2 Production Serving Path (Zero-Cost, D8-D10)
  %% -------------------------------------------------------------------------
  subgraph S_SERVE ["Plan v2 Production Serving Path (Zero Cost, Decisions D8-D10)"]
    direction LR
    P4["<b>Phase 4</b><br/>Backend Foundation Hardening<br/>- Typed settings, no secret defaults<br/>- Postgres + PostGIS and Alembic migrations<br/>- Uniform error envelope and request IDs<br/>- Strict CORS, pinned deps, ruff and mypy<br/>- 44/44 tests (SQLite), 21/21 on Docker PostGIS<br/>[IMPLEMENTED & TESTED] CI green 2026-11-10 (Python 3.13)"]
    P9["<b>Phase 9</b><br/>Versioned Data Products<br/>- COGs: LST, p05, p95, exposure<br/>- Pre-rendered PNG tiles (zoom 10-16)<br/>- Zone metrics and cooling assets in PostGIS<br/>- Atomic latest pointer and SHA-256<br/>- 55 named localities (NMC map), 18,806 tiles<br/>- Uploaded to free Hugging Face dataset repo<br/>[IMPLEMENTED & TESTED] Closed 2026-11-13"]
    P10["<b>Phase 10</b><br/>Automated Inference Pipeline<br/>- GitHub Actions scheduled run (free)<br/>- New scene to ingest, predict, publish<br/>- scene_age_days and stale flag (D2)<br/>- Fallback to last good product<br/>- 4 failure-injection tests green<br/>[IMPLEMENTED & TESTED] Schedule disabled until storage exists"]
    P11["<b>Phase 11</b><br/>Public API v1 (/api/v1)<br/>- /heat, /zones, /cooling-spots<br/>- /tiles, /hotspots, /metadata<br/>- In-memory raster lookups, no live inference<br/>- Frozen OpenAPI contract for the frontend<br/>- p95 under 200 ms at 50 concurrent, 94% coverage<br/>[IMPLEMENTED & TESTED] Closed 2026-11-13"]
    P12["<b>Phase 12</b><br/>Hardening and Zero-Cost Deployment<br/>- Hugging Face Spaces API (Docker)<br/>- Neon Postgres + PostGIS (free)<br/>- UptimeRobot, pg_dump backups, pip-audit<br/>- Coverage gate 85%, Rs 0 recurring cost<br/>[PLANNED] Release"]
    INFRA_STORE[("<b>Free Product Storage</b><br/>- Hugging Face Dataset repo / GitHub Releases<br/>- Versioned COGs, tiles, model files<br/>- Status: [PLANNED]")]

    P4 -- "Secure config, DB schema, error contract" --> P11
    P9 -- "Product bundles" --> INFRA_STORE
    P10 -- "Publishes each new scene" --> P9
    INFRA_STORE -- "Latest bundle loaded at API startup" --> P11
    P11 -- "Deployable Docker image" --> P12
  end

  S_SERVE -- "Deployed, monitored backend (Phase 12 output)" --> S_DELIVERY

  %% -------------------------------------------------------------------------
  %% Tier 4: Acceptance Gates and Delivery Milestones
  %% -------------------------------------------------------------------------
  subgraph S_DELIVERY ["Acceptance Gates and Delivery Milestones"]
    direction LR
    GATE_BE{"<b>Backend Gate Certified?</b><br/>- Warm p95 under 200 ms | Cov 85% plus<br/>- OpenAPI v1 frozen | Rs 0 cost<br/>- Phase 12 verification"}
    GATE_FE{"<b>Frontend Unlocked?</b><br/>- Explicit owner command<br/>- Status: [UNLOCKED 2026-11-13, D20]"}
    FE_DASH["<b>Frontend Web Dashboard (frontend/)</b><br/>- React + TypeScript + Vite app (Home, Map, Zones, About)<br/>- MapLibre map with API heat tiles; zone ranking; cooling places; en/hi/mr<br/>- Consumes frozen /api/v1 OpenAPI contract<br/>- Free hosting (Cloudflare Pages, planned)<br/>- Status: [BUILT] runs against the real API; deployment pending"]

    GATE_BE -- "Owner Command: 'move to frontend'" --> GATE_FE
    GATE_FE -- "Unlocks Branch 2" --> FE_DASH
  end

