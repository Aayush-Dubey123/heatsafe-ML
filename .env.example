# HeatSafe-ML environment template. Copy to `.env` (git-ignored) and fill in.
# Never commit real values.

# development | test | production
HEATSAFE_ENVIRONMENT=development

# Local Postgres password used by docker-compose.yml (choose your own)
HEATSAFE_DB_PASSWORD=change-me-local-only

# SQLAlchemy URL; PostgreSQL is required outside tests.
# Local Docker:  postgresql+psycopg://heatsafe:<HEATSAFE_DB_PASSWORD>@127.0.0.1:5432/heatsafe
# (use 127.0.0.1, not localhost: on Windows "localhost" tries IPv6 first and stalls)
# Neon (prod):   postgresql+psycopg://<user>:<password>@<host>.neon.tech/<db>?sslmode=require
HEATSAFE_DATABASE_URL=postgresql+psycopg://heatsafe:change-me-local-only@127.0.0.1:5432/heatsafe

# Admin JWT signing secret: >= 32 chars, required in production.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
HEATSAFE_JWT_SECRET_KEY=

# Comma-separated browser origins allowed by CORS ("*" is rejected in production)
HEATSAFE_CORS_ORIGINS=http://localhost:3000

# Server bind address (containers use 0.0.0.0)
HEATSAFE_HOST=127.0.0.1
HEATSAFE_PORT=8000
