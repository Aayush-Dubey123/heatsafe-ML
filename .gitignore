# ==============================================================================
# HeatSafe-ML — Single Root Git Ignore Rules
# ==============================================================================

# Local environment configuration (never commit secrets)
.env
.env.*
!.env.example

# Credentials, keys, and certificates
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# Local databases and SQLite files
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite-journal
*.sqlite3-journal

# Operational and lab journals
JOURNAL.txt

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
*.so

# Python virtual environments
venv/
.venv/
.venv*/
*_venv/
env/
ENV/

# Testing, linting, and coverage caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# Application and pipeline logs
*.log
logs/
backend/logs/
ml/logs/

# Geospatial raw, interim, and processed data artifacts
ml/data/raw/
ml/data/interim/
ml/data/processed/
*.tif
*.tiff
*.geotiff
*.nc
*.h5
*.hdf
*.shp
*.shx
*.dbf
*.cpg
*.prj
*.gpkg

# Explicitly track data manifest definitions
!ml/data/manifest/data_manifest.json

# Model weights and serialized pipelines
*.pkl
*.joblib
*.onnx
ml/models/checkpoints/

# Node / Frontend build outputs & dependencies (deferred branch)
node_modules/
dist/
build/
.next/
out/
.cache/

# OS and IDE configuration files
.DS_Store
Thumbs.db
ehthumbs.db
.idea/
.vscode/
*.swp
*.swo
